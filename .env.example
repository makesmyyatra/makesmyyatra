# === Django Core ===
DEBUG=False
SECRET_KEY=your-secret-key-here-generate-with-django
ALLOWED_HOSTS=makesmyyatra.com,www.makesmyyatra.com,makesmyyatra-1.onrender.com

# === Database ===
